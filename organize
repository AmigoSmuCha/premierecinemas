#!/usr/bin/env bash
# =============================================================================
# organize_movies.sh
#
# Reorganizes content under ~/Movies:
#
# PHASE 1 — dated movie subdirectories
#   - Detects movie dirs by the pattern: "Movie Name (YYYY) ..."
#   - Renames the movie file to match the directory name (up to "(YYYY)")
#     e.g. "Betty.Blue.1986.1080p....mp4" → "Betty Blue (1986).mp4"
#   - Moves movie file one level up to Movies/
#   - Moves .srt subtitles sitting directly in the movie folder to
#     Movies/Subtitles/ (kept as-is, whatever language they are)
#   - Nested subtitle folders (e.g. "Subs/", "Subtitles/", or any other
#     sub-folder containing .srt files) are scanned recursively; only
#     subtitles recognised as Czech or English (see EN_LANG_TOKENS /
#     CZ_LANG_TOKENS below) are kept, renamed to match the movie, and moved
#     to Movies/Subtitles/. Every other language found there is moved to
#     Movies/rest/ instead, so the nested folder empties out and the movie
#     folder can still be removed.
#   - Moves everything else (non-video, non-subtitle) to Movies/rest/
#   - Removes the now-empty source subdirectory (including any now-empty
#     nested folders like "Subs/")
#   Directories WITHOUT a "(YYYY)" pattern are left completely untouched here.
#
# PHASE 2 — loose files sitting directly in Movies/
#   - TV episodes: any loose file whose name contains a SxxExx pattern
#     (e.g. "Rick.and.Morty.S09E06.1080p.HEVC.x265-MeGusta[EZTVx.to].mkv")
#     is renamed to "Show Name S00E00[ Episode Name].ext". If a directory
#     already exists in Movies/ whose name matches "Show Name" (case/space
#     insensitive), the file is moved into it. Otherwise it is renamed in
#     place and left in Movies/.
#   - Loose movie dumps: any loose file with no SxxExx pattern but a
#     plausible year (1900-2100) is renamed to "Title (Year).ext" in place.
#   - Anything else is left untouched with a warning.
#   Existing content already inside show subdirectories (e.g. Movies/Rick
#   and Morty/) is NOT touched by this phase — only files loose at the top
#   level of Movies/ are considered.
#
# Usage:
#   ./organize_movies.sh [OPTIONS]
#
# Options:
#   -d, --dry-run       Print what would happen without making any changes
#   -m, --movies-dir    Path to movies directory (default: /home/hamilton/Movies)
#   -h, --help          Show this help message
# =============================================================================

set -euo pipefail

# ── Defaults ──────────────────────────────────────────────────────────────────
MOVIES_DIR="/home/hamilton/Movies"
DRY_RUN=false

# ── Colours ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# ── Helpers ───────────────────────────────────────────────────────────────────
info() { echo -e "${CYAN}[INFO]${RESET}  $*"; }
success() { echo -e "${GREEN}[OK]${RESET}    $*"; }
warn() { echo -e "${YELLOW}[WARN]${RESET}  $*"; }
error() { echo -e "${RED}[ERROR]${RESET} $*" >&2; }
dryrun() { echo -e "${YELLOW}[DRY]${RESET}   $*"; }

do_move() {
  # do_move <src> <dst_dir>
  local src="$1" dst_dir="$2"
  local filename
  filename="$(basename "$src")"
  local dst="$dst_dir/$filename"

  # Handle name collisions
  if [[ -e "$dst" ]]; then
    local base="${filename%.*}"
    local ext="${filename##*.}"
    dst="$dst_dir/${base}_$(date +%s).${ext}"
    warn "Collision – renaming to: $(basename "$dst")"
  fi

  if $DRY_RUN; then
    dryrun "mv $(printf '%q' "$src") $(printf '%q' "$dst")"
  else
    mv -- "$src" "$dst"
  fi
}

# do_move_rename <src> <dst_dir> <new_filename>
# Like do_move, but lets the caller specify the destination filename
# (used for renaming-and-moving loose TV episode files in one step).
# Sets the global LAST_DST to the final destination path. (Deliberately not
# printed via stdout+command-substitution, since callers already use stdout
# for [DRY]/[WARN] logging and that would get silently captured instead of
# shown to the user.)
do_move_rename() {
  local src="$1" dst_dir="$2" new_name="$3"
  local dst="$dst_dir/$new_name"

  if [[ -e "$dst" && "$dst" != "$src" ]]; then
    local base="${new_name%.*}"
    local ext="${new_name##*.}"
    dst="$dst_dir/${base}_$(date +%s).${ext}"
    warn "Collision – renaming to: $(basename "$dst")"
  fi

  if $DRY_RUN; then
    dryrun "mv $(printf '%q' "$src") $(printf '%q' "$dst")"
  else
    mv -- "$src" "$dst"
  fi
  LAST_DST="$dst"
}

# ── Language detection for subtitle files found in nested folders ────────────
# We only care about Czech and English here; anything else comes back empty
# so the caller can route it to rest/ instead. Edit these two lists if you
# ever need another language kept automatically.
EN_LANG_TOKENS="en|eng|english"
CZ_LANG_TOKENS="cz|cze|ces|cs|czech"

# detect_subtitle_language <filename-without-extension>
# Splits the name on any non-alphanumeric character (so "SDH.eng.HI" becomes
# the tokens sdh/eng/hi) and checks each token against the lists above.
# Echoes "en" or "cz" (with ".sdh" appended when an "sdh" token is also
# present, e.g. "en.sdh") and returns 0 on a match. Echoes nothing and
# returns 1 if no recognised language token is found.
detect_subtitle_language() {
  local name="${1,,}"
  local -a tokens
  read -ra tokens <<<"$(echo "$name" | tr -c '[:alnum:]' ' ')"

  local lang="" is_sdh=false
  local t
  for t in "${tokens[@]}"; do
    [[ "$t" == "sdh" ]] && is_sdh=true
    if [[ -z "$lang" && "$t" =~ ^(${EN_LANG_TOKENS})$ ]]; then
      lang="en"
    elif [[ -z "$lang" && "$t" =~ ^(${CZ_LANG_TOKENS})$ ]]; then
      lang="cz"
    fi
  done

  [[ -z "$lang" ]] && return 1

  if $is_sdh; then
    echo "${lang}.sdh"
  else
    echo "$lang"
  fi
}

# ── Argument parsing ───────────────────────────────────────────────────────────
usage() {
  grep '^# ' "$0" | sed 's/^# \?//'
  exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -d | --dry-run)
    DRY_RUN=true
    shift
    ;;
  -m | --movies-dir)
    MOVIES_DIR="$2"
    shift 2
    ;;
  -h | --help) usage ;;
  *)
    error "Unknown option: $1"
    exit 1
    ;;
  esac
done

# ── Validate base directory ───────────────────────────────────────────────────
if [[ ! -d "$MOVIES_DIR" ]]; then
  error "Movies directory not found: $MOVIES_DIR"
  exit 1
fi

SUBTITLES_DIR="$MOVIES_DIR/Subtitles"
REST_DIR="$MOVIES_DIR/rest"

# ── Movie file extensions (video formats) ─────────────────────────────────────
MOVIE_EXTENSIONS="mp4|mkv|avi|mov|m4v|wmv|flv|webm|ts|m2ts|mpeg|mpg"

# ── Tags that mark the end of useful title/episode text (resolution, codec,
#    source, audio, release tags). Extend this list if your files use tags
#    that aren't caught here. Matched as a case-insensitive PREFIX of each
#    whitespace-separated token, so "x265-MeGusta" is caught by "x265".
JUNK_RE='2160p|1080p|720p|480p|360p|4k|uhd|hdr[0-9]*|hevc|avc|x264|x265|h264|h265|webdl|web-dl|webrip|web|bluray|blu-ray|brrip|bdrip|dvdrip|hdtv|hdrip|amzn|nf|dsnp|atvp|hmax|hulu|multi|dual|aac[0-9]*|ac3|eac3|dts[a-z0-9]*|10bit|8bit|remux|repack|proper|extended|uncut|internal|limited'

# ── Create output directories ─────────────────────────────────────────────────
if $DRY_RUN; then
  dryrun "mkdir -p $(printf '%q' "$SUBTITLES_DIR")"
  dryrun "mkdir -p $(printf '%q' "$REST_DIR")"
else
  mkdir -p "$SUBTITLES_DIR"
  mkdir -p "$REST_DIR"
fi

echo ""
echo -e "${BOLD}=== Movie Organiser ===${RESET}"
echo -e "Movies dir : ${BOLD}$MOVIES_DIR${RESET}"
echo -e "Subtitles  : ${BOLD}$SUBTITLES_DIR${RESET}"
echo -e "Rest       : ${BOLD}$REST_DIR${RESET}"
$DRY_RUN && echo -e "${YELLOW}*** DRY-RUN MODE – no files will be changed ***${RESET}"
echo ""

# ── Main loop ─────────────────────────────────────────────────────────────────
# Pattern: directory name contains "(YYYY)" where YYYY is 4 digits
MOVIE_DIR_PATTERN='\([0-9]{4}\)'

processed=0
skipped=0
nested_subs_kept=0
nested_subs_dropped=0

echo -e "${BOLD}--- Phase 1: dated movie subdirectories ---${RESET}"
echo ""

while IFS= read -r -d '' subdir; do
  dirname="$(basename "$subdir")"

  # ── Only process directories matching "Something (YYYY)" ──────────────────
  if ! echo "$dirname" | grep -qP "$MOVIE_DIR_PATTERN"; then
    info "Skipping (no year pattern): $dirname"
    ((skipped++)) || true
    continue
  fi

  echo -e "${BOLD}Processing:${RESET} $dirname"

  # ── Extract the canonical movie name: everything up to and including (YYYY)
  # e.g. "Betty Blue (1986) [1080p] [BluRay] [YTS.MX]" → "Betty Blue (1986)"
  canonical_name="$(echo "$dirname" | grep -oP '^.*?\([0-9]{4}\)')"

  # ── Iterate over files directly inside this movie directory ────────────────
  movie_found=false
  while IFS= read -r -d '' file; do
    filename="$(basename "$file")"
    ext="${filename##*.}"
    ext_lower="${ext,,}" # lowercase

    if echo "$ext_lower" | grep -qP "^($MOVIE_EXTENSIONS)$"; then
      # ── It's a movie file: rename to canonical_name + original extension
      new_name="${canonical_name}.${ext_lower}"
      dst="$MOVIES_DIR/$new_name"

      # Handle collision
      if [[ -e "$dst" && "$file" != "$dst" ]]; then
        base="${new_name%.*}"
        dst="$MOVIES_DIR/${base}_$(date +%s).${ext_lower}"
        warn "Movie collision – saving as: $(basename "$dst")"
      fi

      if $DRY_RUN; then
        dryrun "mv $(printf '%q' "$file") $(printf '%q' "$dst")"
      else
        mv -- "$file" "$dst"
        success "Movie → $(basename "$dst")"
      fi
      movie_found=true

    elif [[ "$ext_lower" == "srt" ]]; then
      # ── Subtitle sitting directly in the movie folder: move to Subtitles/,
      # rename to match canonical name. Kept as-is regardless of language,
      # since this is usually the single subtitle bundled with the release
      # (often with no language tag at all, e.g. plain "Movie.srt").
      # Preserve language tags if present in the filename (e.g. .en.srt, .fr.srt)
      lang_code=""
      if echo "$filename" | grep -qP '\.[a-z]{2,3}\.srt$'; then
        lang_code="$(echo "$filename" | grep -oP '\.[a-z]{2,3}(?=\.srt$)')"
      fi

      new_srt="${canonical_name}${lang_code}.srt"
      dst="$SUBTITLES_DIR/$new_srt"

      if [[ -e "$dst" ]]; then
        dst="$SUBTITLES_DIR/${canonical_name}${lang_code}_$(date +%s).srt"
        warn "Subtitle collision – saving as: $(basename "$dst")"
      fi

      if $DRY_RUN; then
        dryrun "mv $(printf '%q' "$file") $(printf '%q' "$dst")"
      else
        mv -- "$file" "$dst"
        success "Subtitle → Subtitles/$(basename "$dst")"
      fi

    else
      # ── Everything else → rest/
      do_move "$file" "$REST_DIR"
      if ! $DRY_RUN; then
        success "Other → rest/$filename"
      fi
    fi

  done < <(find "$subdir" -maxdepth 1 -type f -print0)

  if ! $movie_found; then
    warn "No movie file found in: $dirname"
  fi

  # ── Nested subtitle folders (e.g. "Subs/", "Subtitles/") ────────────────────
  # Any .srt file found ANYWHERE below the top level of $subdir (regardless
  # of what the containing folder is called) is checked for a Czech or
  # English language marker. Matches are renamed to match the movie and
  # moved to Subtitles/; everything else (other languages, unlabeled dumps)
  # is moved to rest/ so the nested folder empties out.
  while IFS= read -r -d '' sfile; do
    sfilename="$(basename "$sfile")"
    sbase="${sfilename%.*}"
    lang="$(detect_subtitle_language "$sbase" || true)"

    if [[ -z "$lang" ]]; then
      do_move_rename "$sfile" "$REST_DIR" "${canonical_name} - ${sfilename}"
      if ! $DRY_RUN; then
        info "Nested subtitle (unwanted language) → rest/$(basename "$LAST_DST")"
      fi
      ((nested_subs_dropped++)) || true
      continue
    fi

    new_srt="${canonical_name}.${lang}.srt"
    dst="$SUBTITLES_DIR/$new_srt"
    if [[ -e "$dst" ]]; then
      dst="$SUBTITLES_DIR/${canonical_name}.${lang}_$(date +%s).srt"
      warn "Subtitle collision – saving as: $(basename "$dst")"
    fi

    if $DRY_RUN; then
      dryrun "mv $(printf '%q' "$sfile") $(printf '%q' "$dst")"
    else
      mv -- "$sfile" "$dst"
      success "Nested subtitle → Subtitles/$(basename "$dst")"
    fi
    ((nested_subs_kept++)) || true

  done < <(find "$subdir" -mindepth 2 -type f -iname "*.srt" -print0)

  # ── Clean up now-empty nested subdirectories (e.g. an emptied "Subs/") ────
  # Only relevant on a real run — in dry-run mode nothing was actually moved.
  if ! $DRY_RUN; then
    find "$subdir" -mindepth 1 -type d -empty -delete 2>/dev/null || true
  fi

  # ── Remove the (now empty) source directory ────────────────────────────────
  # Only if the directory is actually empty
  remaining_files=$(find "$subdir" -mindepth 1 -type f | wc -l)
  remaining_dirs=$(find "$subdir" -mindepth 1 -type d | wc -l)

  if [[ "$remaining_files" -eq 0 && "$remaining_dirs" -eq 0 ]]; then
    if $DRY_RUN; then
      dryrun "rmdir $(printf '%q' "$subdir")"
    else
      rmdir "$subdir" && success "Removed empty dir: $dirname"
    fi
  else
    warn "Directory not empty after processing (skipping rmdir): $dirname"
    warn "  Remaining files: $remaining_files, dirs: $remaining_dirs"
  fi

  ((processed++)) || true
  echo ""

done < <(find "$MOVIES_DIR" -maxdepth 1 -mindepth 1 -type d -print0 | sort -z)

# =============================================================================
# PHASE 2 — loose files sitting directly in Movies/
# =============================================================================

# clean_title_fragment <string>
# Turns a raw filename fragment into a clean title: dots/underscores become
# spaces, whitespace is collapsed, and stray separators at the edges
# (spaces, dashes, parens, brackets) are trimmed.
clean_title_fragment() {
  local s="$1"
  s="${s//./ }"
  s="${s//_/ }"
  s="$(echo "$s" | tr -s '[:space:]' ' ')"
  s="$(echo "$s" | sed -E 's/^[[:space:]()\[-]+//; s/[[:space:]()\[-]+$//')"
  echo "$s"
}

# strip_junk_suffix <string>
# Given a cleaned, space-separated string, keeps only the leading words up
# to (but not including) the first word that looks like a quality/codec/
# release tag, or starts with "[". This is how an episode name is separated
# from trailing metadata (assumes, per your note, that no real episode name
# contains a resolution/codec tag).
strip_junk_suffix() {
  local s="$1"
  local -a words=() kept=()
  read -ra words <<<"$s"
  local w wl
  for w in "${words[@]}"; do
    wl="${w,,}"
    if [[ "$wl" =~ ^(${JUNK_RE}) ]] || [[ "$w" == \[* ]]; then
      break
    fi
    kept+=("$w")
  done
  echo "${kept[*]}"
}

# normalize_for_compare <string>
# Lowercases and collapses whitespace, for case/space-insensitive matching
# of a show name against existing directory names.
normalize_for_compare() {
  local s="$1"
  s="${s,,}"
  s="$(echo "$s" | tr -s '[:space:]' ' ')"
  s="$(echo "$s" | sed -E 's/^ +| +$//g')"
  echo "$s"
}

# classify_and_build_name <basename-without-extension>
# Sets globals: IS_EPISODE, CANON_NAME, SHOW_NAME, EP_TAG, EP_SUFFIX.
# EP_TAG/EP_SUFFIX let the caller rebuild CANON_NAME using a matched show
# directory's exact spelling instead of whatever casing was in the source
# filename. Returns 1 if the name could not be classified as either a TV
# episode or a movie.
classify_and_build_name() {
  local base_no_ext="$1"
  IS_EPISODE=false
  CANON_NAME=""
  SHOW_NAME=""
  EP_TAG=""
  EP_SUFFIX=""

  # ── TV episode: look for a SxxExx style token anywhere in the name ────────
  if [[ "$base_no_ext" =~ ([Ss][0-9]{1,2}[Ee][0-9]{1,2}) ]]; then
    local token="${BASH_REMATCH[1]}"
    [[ "$token" =~ ^[Ss]([0-9]{1,2})[Ee]([0-9]{1,2})$ ]]
    local season_num="${BASH_REMATCH[1]}" episode_num="${BASH_REMATCH[2]}"
    local sxxexx
    sxxexx="S$(printf '%02d' "$((10#$season_num))")E$(printf '%02d' "$((10#$episode_num))")"

    local prefix="${base_no_ext%%"$token"*}"
    local suffix="${base_no_ext#*"$token"}"

    prefix="$(clean_title_fragment "$prefix")"
    suffix="$(clean_title_fragment "$suffix")"
    suffix="$(strip_junk_suffix "$suffix")"

    # Can't build a sensible name without a show name up front
    [[ -z "$prefix" ]] && return 1

    IS_EPISODE=true
    SHOW_NAME="$prefix"
    EP_TAG="$sxxexx"
    EP_SUFFIX="$suffix"
    if [[ -n "$suffix" ]]; then
      CANON_NAME="${prefix} ${sxxexx} ${suffix}"
    else
      CANON_NAME="${prefix} ${sxxexx}"
    fi
    return 0
  fi

  # ── Otherwise: look for a plausible year (1900-2100), not part of a
  #    longer digit run (so "2160p" doesn't get mistaken for a year) ────────
  if [[ "$base_no_ext" =~ (^|[^0-9])(19[0-9]{2}|20[0-9]{2}|2100)([^0-9]|$) ]]; then
    local year="${BASH_REMATCH[2]}"
    local prefix="${base_no_ext%%"$year"*}"
    prefix="$(clean_title_fragment "$prefix")"

    [[ -z "$prefix" ]] && return 1

    CANON_NAME="${prefix} (${year})"
    return 0
  fi

  return 1
}

echo -e "${BOLD}--- Phase 2: loose files in $MOVIES_DIR ---${RESET}"
echo ""

loose_moved=0
loose_renamed=0
loose_already_ok=0
loose_unclassified=0

while IFS= read -r -d '' file; do
  filename="$(basename "$file")"
  ext="${filename##*.}"
  ext_lower="${ext,,}"

  # Only touch recognised video files here
  if ! echo "$ext_lower" | grep -qP "^($MOVIE_EXTENSIONS)$"; then
    continue
  fi

  base_no_ext="${filename%.*}"

  if ! classify_and_build_name "$base_no_ext"; then
    warn "Could not determine name (no S00E00 or year found): $filename"
    ((loose_unclassified++)) || true
    continue
  fi

  # ── Work out the target directory ──────────────────────────────────────
  target_dir="$MOVIES_DIR"
  if $IS_EPISODE; then
    show_norm="$(normalize_for_compare "$SHOW_NAME")"
    while IFS= read -r -d '' d; do
      dbase="$(basename "$d")"
      [[ "$dbase" == "rest" || "$dbase" == "Subtitles" ]] && continue
      # Skip dated movie subdirs left over from Phase 1 patterns
      echo "$dbase" | grep -qP "$MOVIE_DIR_PATTERN" && continue
      dnorm="$(normalize_for_compare "$dbase")"
      if [[ "$dnorm" == "$show_norm" ]]; then
        target_dir="$d"
        break
      fi
    done < <(find "$MOVIES_DIR" -maxdepth 1 -mindepth 1 -type d -print0)

    # Matched an existing show folder — use its exact spelling/casing
    # instead of whatever casing happened to be in the source filename.
    if [[ "$target_dir" != "$MOVIES_DIR" ]]; then
      matched_show_name="$(basename "$target_dir")"
      if [[ -n "$EP_SUFFIX" ]]; then
        CANON_NAME="${matched_show_name} ${EP_TAG} ${EP_SUFFIX}"
      else
        CANON_NAME="${matched_show_name} ${EP_TAG}"
      fi
    fi
  fi

  final_name="${CANON_NAME}.${ext_lower}"
  target_path="$target_dir/$final_name"

  if [[ "$target_path" == "$file" ]]; then
    ((loose_already_ok++)) || true
    continue
  fi

  do_move_rename "$file" "$target_dir" "$final_name"
  dst="$LAST_DST"

  if [[ "$target_dir" == "$MOVIES_DIR" ]]; then
    if ! $DRY_RUN; then
      success "Renamed (no matching show folder) → $(basename "$dst")"
    fi
    ((loose_renamed++)) || true
  else
    if ! $DRY_RUN; then
      success "Episode → $(basename "$target_dir")/$(basename "$dst")"
    fi
    ((loose_moved++)) || true
  fi

done < <(find "$MOVIES_DIR" -maxdepth 1 -mindepth 1 -type f -print0 | sort -z)

echo ""

# ── Summary ───────────────────────────────────────────────────────────────────
echo -e "${BOLD}=== Done ===${RESET}"
echo -e "  Phase 1 — movie dirs processed        : ${GREEN}${processed}${RESET}"
echo -e "  Phase 1 — dirs skipped (series)       : ${YELLOW}${skipped}${RESET}"
echo -e "  Phase 1 — nested subs kept (cz/en)    : ${GREEN}${nested_subs_kept}${RESET}"
echo -e "  Phase 1 — nested subs dropped→rest    : ${YELLOW}${nested_subs_dropped}${RESET}"
echo -e "  Phase 2 — episodes moved to show dir : ${GREEN}${loose_moved}${RESET}"
echo -e "  Phase 2 — renamed, no show dir found : ${GREEN}${loose_renamed}${RESET}"
echo -e "  Phase 2 — already correctly named    : ${CYAN}${loose_already_ok}${RESET}"
echo -e "  Phase 2 — could not classify         : ${YELLOW}${loose_unclassified}${RESET}"
$DRY_RUN && echo -e "\n${YELLOW}Dry-run complete. Run without -d to apply changes.${RESET}"
